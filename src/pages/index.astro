---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';

const TITLE = 'Nikita Mikaev';
const SUBTITLE = 'Photography';

const CONTACTS = [
  { kind: 'instagram', label: 'Instagram', value: '@nikitas.roll', href: 'https://instagram.com/nikitas.roll' },
  { kind: 'telegram', label: 'Telegram', value: '@turingalan', href: 'https://t.me/turingalan' },
  { kind: 'email', label: 'Email', value: 'n.v.mikaev@gmail.com', href: 'mailto:n.v.mikaev@gmail.com' },
];

// WebP-мастера из src/photos (их готовит `npm run photos`).
// Папка = альбом, имя файла = название фото:
//   src/photos/Abstract/The Theater of Absurd.webp → альбом «Abstract», фото «The Theater of Absurd».
// Порядок — по имени. Необязательный числовой префикс («01 », «01-», «01. ») задаёт порядок
// и в название не попадает. Имена с камеры (DSC02537, IMG_1234) выводятся без названия.
const modules = import.meta.glob<{ default: ImageMetadata }>('../photos/**/*.webp', { eager: true });

const CAMERA_NAME = /^(_?DSC[FN]?|IMG|PXL|DJI|GOPR|MVIMG)[_-]?\d/i;
const titleOf = (name: string) =>
  CAMERA_NAME.test(name) ? '' : name.replace(/^\d+[-_. ]+/, '').replace(/_/g, ' ').trim();
const albumOf = (path: string) => {
  const parts = path.replace('../photos/', '').split('/');
  if (parts.length < 2) return null;
  const title = titleOf(parts[0]) || parts[0];
  return { slug: title.toLowerCase().replace(/\s+/g, '-'), title };
};

// Превью в сетке: ширины под 1–3 колонки на обычных и retina-экранах.
const THUMB_WIDTHS = [480, 800, 1200, 1600];
const THUMB_QUALITY = 80;
// Полноэкранный просмотр: браузер сам выберет размер по экрану и DPR.
const FULL_WIDTHS = [1280, 1920, 2560];
const FULL_QUALITY = 85;

const photos = await Promise.all(
  Object.entries(modules)
    .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
    .map(async ([path, mod]) => {
      const name = path.split('/').pop()!.replace(/\.[^.]+$/, '');
      const title = titleOf(name);
      const widths = FULL_WIDTHS.filter((w) => w < mod.default.width);
      if (widths.length === 0 || mod.default.width <= 2560) widths.push(Math.min(mod.default.width, 2560));
      const full = await getImage({
        src: mod.default,
        width: Math.min(mod.default.width, 1920), // fallback src для старых браузеров
        widths: [...new Set(widths)],
        sizes: '100vw',
        format: 'webp',
        quality: FULL_QUALITY,
      });
      return { src: mod.default, title, href: full.src, srcset: full.srcSet.attribute, album: albumOf(path) };
    }),
);

const albums = [...new Map(photos.filter((p) => p.album).map((p) => [p.album!.slug, p.album!])).values()].map(
  (a) => ({ ...a, count: photos.filter((p) => p.album?.slug === a.slug).length }),
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{TITLE} — {SUBTITLE}</title>
    <meta name="description" content={`${SUBTITLE} by ${TITLE}`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;1,400&family=Inter:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header>
      <h1>{TITLE}</h1>
      <p>{SUBTITLE}</p>
      <a class="contact-link" href="#contact">Contact me</a>
    </header>

    <main>
      {
        photos.length === 0 ? (
          <p class="empty">Положите фото в <code>originals/</code> и запустите <code>npm run photos</code> — и они появятся здесь.</p>
        ) : (
          <>
          {albums.length > 0 && (
            <nav class="albums" aria-label="Albums">
              <button class="chip" data-album="" aria-pressed="true">
                All <span>{photos.length}</span>
              </button>
              {albums.map((a) => (
                <button class="chip" data-album={a.slug} aria-pressed="false">
                  {a.title} <span>{a.count}</span>
                </button>
              ))}
            </nav>
          )}
          <div class="grid">
            {photos.map((p, i) => (
              <a
                class="item"
                href={p.href}
                data-srcset={p.srcset}
                data-album={p.album?.slug ?? ''}
                data-title={p.title}
                data-album-title={p.album?.title ?? ''}
                style={`--d:${Math.min(i, 12) * 60}ms`}>
                <Image
                  src={p.src}
                  alt={p.title || p.album?.title || 'Photo'}
                  width={Math.min(p.src.width, 1200)}
                  widths={THUMB_WIDTHS}
                  sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 33vw"
                  format="webp"
                  quality={THUMB_QUALITY}
                  loading={i < 3 ? 'eager' : 'lazy'}
                />
                {(p.title || p.album) && (
                  <span class="caption">
                    {p.title && <span class="caption-title">{p.title}</span>}
                    {p.album && <span class="caption-album">{p.album.title}</span>}
                  </span>
                )}
              </a>
            ))}
          </div>
          </>
        )
      }

      <section id="contact" class="contact">
        <h2>Contact me</h2>
        <p>Съёмки, сотрудничество или просто поговорить о фото — пишите.</p>
        <div class="contact-cards">
          {CONTACTS.map((c) => (
            <a class="card" href={c.href} target={c.kind === 'email' ? undefined : '_blank'} rel="noopener">
              {c.kind === 'instagram' && (
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" /></svg>
              )}
              {c.kind === 'telegram' && (
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 4 3 11l6 2.5M21 4l-3.5 16-8.5-6.5M21 4 9 13.5V19l3-3.5" /></svg>
              )}
              {c.kind === 'email' && (
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3.5 6 8.5 7 8.5-7" /></svg>
              )}
              <span class="card-label">{c.label}</span>
              <span class="card-value">{c.value}</span>
            </a>
          ))}
        </div>
      </section>
    </main>

    <footer>© {new Date().getFullYear()} {TITLE}</footer>

    <div class="lightbox" hidden aria-modal="true" role="dialog">
      <button class="lb-close" aria-label="Close">×</button>
      <button class="lb-prev" aria-label="Previous">‹</button>
      <img class="lb-img" alt="" sizes="100vw" />
      <button class="lb-next" aria-label="Next">›</button>
      <div class="lb-caption">
        <span class="lb-title"></span>
        <span class="lb-meta"><span class="lb-album"></span><span class="lb-count"></span></span>
      </div>
    </div>

    <script>
      const items = [...document.querySelectorAll<HTMLAnchorElement>('.item')];
      const chips = [...document.querySelectorAll<HTMLButtonElement>('.chip')];
      let visible = items;

      // Фильтр по альбомам; выбранный альбом хранится в ?album=… — ссылкой можно поделиться.
      function filter(album: string) {
        if (album && !chips.some((c) => c.dataset.album === album)) album = '';
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.album === album)));
        items.forEach((a) => (a.hidden = !!album && a.dataset.album !== album));
        visible = items.filter((a) => !a.hidden);
        const url = new URL(location.href);
        if (album) url.searchParams.set('album', album);
        else url.searchParams.delete('album');
        history.replaceState(null, '', url);
      }
      chips.forEach((c) => c.addEventListener('click', () => filter(c.dataset.album ?? '')));
      filter(new URLSearchParams(location.search).get('album') ?? '');

      const box = document.querySelector<HTMLElement>('.lightbox')!;
      const img = box.querySelector<HTMLImageElement>('.lb-img')!;
      const count = box.querySelector<HTMLElement>('.lb-count')!;
      const lbTitle = box.querySelector<HTMLElement>('.lb-title')!;
      const lbAlbum = box.querySelector<HTMLElement>('.lb-album')!;
      let current = 0;

      function show(i: number) {
        current = (i + visible.length) % visible.length;
        const a = visible[current];
        img.classList.remove('loaded');
        img.onload = () => img.classList.add('loaded');
        img.srcset = a.dataset.srcset ?? '';
        img.src = a.href;
        img.alt = a.querySelector('img')?.alt ?? '';
        count.textContent = `${current + 1} / ${visible.length}`;
        lbTitle.textContent = a.dataset.title ?? '';
        lbAlbum.textContent = a.dataset.albumTitle ?? '';
        // Подгружаем соседей заранее
        [current - 1, current + 1].forEach((j) => {
          const n = visible[(j + visible.length) % visible.length];
          if (!n) return;
          const pre = new Image();
          pre.sizes = '100vw';
          pre.srcset = n.dataset.srcset ?? '';
          pre.src = n.href;
        });
      }

      function open(i: number) {
        show(i);
        box.hidden = false;
        document.body.style.overflow = 'hidden';
      }

      function close() {
        box.hidden = true;
        document.body.style.overflow = '';
      }

      items.forEach((a) =>
        a.addEventListener('click', (e) => {
          e.preventDefault();
          open(visible.indexOf(a));
        }),
      );

      box.querySelector('.lb-close')!.addEventListener('click', close);
      box.querySelector('.lb-prev')!.addEventListener('click', () => show(current - 1));
      box.querySelector('.lb-next')!.addEventListener('click', () => show(current + 1));
      box.addEventListener('click', (e) => {
        if (e.target === box) close();
      });

      document.addEventListener('keydown', (e) => {
        if (box.hidden) return;
        if (e.key === 'Escape') close();
        if (e.key === 'ArrowLeft') show(current - 1);
        if (e.key === 'ArrowRight') show(current + 1);
      });

      let startX = 0;
      box.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
      box.addEventListener('touchend', (e) => {
        const dx = e.changedTouches[0].clientX - startX;
        if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
      });
    </script>

    <style is:global>
      :root {
        --bg: #0e0e0e;
        --fg: #ededed;
        --muted: #8a8a8a;
        --gap: 14px;
        color-scheme: dark;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; }
      body {
        background: var(--bg);
        color: var(--fg);
        font-family: 'Inter', system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
    </style>

    <style>
      header {
        text-align: center;
        padding: clamp(48px, 10vw, 110px) 16px clamp(32px, 6vw, 64px);
      }
      h1 {
        font-family: 'Cormorant Garamond', Georgia, serif;
        font-weight: 400;
        font-size: clamp(2.4rem, 6vw, 4.2rem);
        letter-spacing: 0.02em;
        margin: 0;
      }
      header p {
        margin: 10px 0 0;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.35em;
        font-size: 0.75rem;
      }

      .contact-link {
        display: inline-block;
        margin-top: 22px;
        color: var(--fg);
        font-size: 0.8rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        text-decoration: none;
        border-bottom: 1px solid #444;
        padding-bottom: 3px;
        transition: border-color 0.2s;
      }
      .contact-link:hover { border-color: var(--fg); }

      .albums {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 10px;
        margin: 0 auto 34px;
      }
      .chip {
        font: inherit;
        font-size: 0.85rem;
        color: var(--muted);
        background: transparent;
        border: 1px solid #2c2c2c;
        border-radius: 999px;
        padding: 8px 18px;
        cursor: pointer;
        transition: color 0.2s, border-color 0.2s, background 0.2s;
      }
      .chip span {
        font-size: 0.72rem;
        opacity: 0.6;
        margin-left: 4px;
      }
      .chip:hover { color: var(--fg); border-color: #555; }
      .chip[aria-pressed='true'] {
        color: var(--bg);
        background: var(--fg);
        border-color: var(--fg);
      }

      main {
        max-width: 1600px;
        margin: 0 auto;
        padding: 0 var(--gap);
      }
      .grid {
        columns: 3 320px;
        column-gap: var(--gap);
      }
      .item {
        display: block;
        margin-bottom: var(--gap);
        break-inside: avoid;
        overflow: hidden;
        border-radius: 3px;
        background: #1a1a1a;
        cursor: zoom-in;
        opacity: 0;
        animation: fade-in 0.8s ease forwards;
        animation-delay: var(--d);
      }
      .item[hidden] { display: none; }
      .item { position: relative; }
      .caption {
        position: absolute;
        inset: auto 0 0 0;
        display: flex;
        flex-direction: column;
        gap: 2px;
        padding: 40px 16px 14px;
        background: linear-gradient(transparent, rgba(0, 0, 0, 0.65));
        color: #fff;
        opacity: 0;
        transform: translateY(6px);
        transition: opacity 0.35s ease, transform 0.35s ease;
        pointer-events: none;
      }
      .item:hover .caption,
      .item:focus-visible .caption {
        opacity: 1;
        transform: none;
      }
      .caption-title {
        font-family: 'Cormorant Garamond', Georgia, serif;
        font-style: italic;
        font-size: 1.3rem;
        line-height: 1.2;
      }
      .caption-album {
        font-size: 0.68rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        opacity: 0.75;
      }
      /* На телефонах наведения нет — подпись всегда видна под фото */
      @media (hover: none) {
        .item { background: transparent; border-radius: 0; }
        .item :global(img) { border-radius: 3px; }
        .caption {
          position: static;
          opacity: 1;
          transform: none;
          background: none;
          padding: 8px 2px 4px;
        }
        .caption-title { font-size: 1.1rem; }
        .caption-album { color: var(--muted); opacity: 1; }
      }
      .item :global(img) {
        display: block;
        width: 100%;
        height: auto;
        transition: transform 0.6s ease, filter 0.6s ease;
      }
      .item:hover :global(img) {
        transform: scale(1.03);
        filter: brightness(1.08);
      }
      @keyframes fade-in {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: none; }
      }

      .empty {
        text-align: center;
        color: var(--muted);
        padding: 80px 0;
      }
      code {
        background: #1d1d1d;
        padding: 2px 6px;
        border-radius: 4px;
      }

      .contact {
        max-width: 880px;
        margin: clamp(64px, 10vw, 120px) auto 0;
        text-align: center;
        scroll-margin-top: 40px;
      }
      h2 {
        font-family: 'Cormorant Garamond', Georgia, serif;
        font-weight: 400;
        font-size: clamp(2rem, 4.5vw, 3rem);
        margin: 0;
      }
      .contact > p {
        color: var(--muted);
        margin: 12px 0 36px;
      }
      .contact-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: var(--gap);
      }
      .card {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        padding: 30px 16px;
        border: 1px solid #242424;
        border-radius: 6px;
        background: #141414;
        color: var(--fg);
        text-decoration: none;
        transition: border-color 0.25s, background 0.25s, transform 0.25s;
      }
      .card:hover {
        border-color: #4a4a4a;
        background: #191919;
        transform: translateY(-2px);
      }
      .card svg {
        width: 26px;
        height: 26px;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.5;
        stroke-linecap: round;
        stroke-linejoin: round;
        margin-bottom: 8px;
      }
      .card-label {
        font-size: 0.72rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--muted);
      }
      .card-value {
        font-size: 0.95rem;
        overflow-wrap: anywhere;
      }

      footer {
        text-align: center;
        color: var(--muted);
        font-size: 0.8rem;
        padding: 56px 16px 40px;
      }

      .lightbox {
        position: fixed;
        inset: 0;
        z-index: 10;
        background: rgba(5, 5, 5, 0.96);
        display: flex;
        align-items: center;
        justify-content: center;
        animation: lb-in 0.25s ease;
      }
      .lightbox[hidden] { display: none; }
      @keyframes lb-in { from { opacity: 0; } }
      .lb-img {
        max-width: 92vw;
        max-height: 80vh;
        object-fit: contain;
        opacity: 0;
        transition: opacity 0.3s ease;
        user-select: none;
      }
      .lb-img.loaded { opacity: 1; }
      .lightbox button {
        position: absolute;
        background: none;
        border: 0;
        color: var(--fg);
        font-size: 2.6rem;
        line-height: 1;
        padding: 16px;
        cursor: pointer;
        opacity: 0.6;
        transition: opacity 0.2s;
      }
      .lightbox button:hover { opacity: 1; }
      .lb-close { top: 8px; right: 12px; }
      .lb-prev { left: 8px; top: 50%; transform: translateY(-50%); }
      .lb-next { right: 8px; top: 50%; transform: translateY(-50%); }
      .lb-img { margin-bottom: 40px; }
      .lb-caption {
        position: absolute;
        bottom: 14px;
        left: 16px;
        right: 16px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        text-align: center;
      }
      .lb-title {
        font-family: 'Cormorant Garamond', Georgia, serif;
        font-style: italic;
        font-size: 1.25rem;
      }
      .lb-title:empty { display: none; }
      .lb-meta {
        color: var(--muted);
        font-size: 0.72rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
      }
      .lb-album:not(:empty)::after { content: ' · '; }
      @media (max-width: 640px) {
        .lb-prev, .lb-next { display: none; }
        .lb-img { max-width: 100vw; }
      }
      @media (prefers-reduced-motion: reduce) {
        .item { animation: none; opacity: 1; }
        .item[hidden] { display: none; }
      .item { position: relative; }
      .caption {
        position: absolute;
        inset: auto 0 0 0;
        display: flex;
        flex-direction: column;
        gap: 2px;
        padding: 40px 16px 14px;
        background: linear-gradient(transparent, rgba(0, 0, 0, 0.65));
        color: #fff;
        opacity: 0;
        transform: translateY(6px);
        transition: opacity 0.35s ease, transform 0.35s ease;
        pointer-events: none;
      }
      .item:hover .caption,
      .item:focus-visible .caption {
        opacity: 1;
        transform: none;
      }
      .caption-title {
        font-family: 'Cormorant Garamond', Georgia, serif;
        font-style: italic;
        font-size: 1.3rem;
        line-height: 1.2;
      }
      .caption-album {
        font-size: 0.68rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        opacity: 0.75;
      }
      /* На телефонах наведения нет — подпись всегда видна под фото */
      @media (hover: none) {
        .item { background: transparent; border-radius: 0; }
        .item :global(img) { border-radius: 3px; }
        .caption {
          position: static;
          opacity: 1;
          transform: none;
          background: none;
          padding: 8px 2px 4px;
        }
        .caption-title { font-size: 1.1rem; }
        .caption-album { color: var(--muted); opacity: 1; }
      }
      .item :global(img) { transition: none; }
      }
    </style>
  </body>
</html>
