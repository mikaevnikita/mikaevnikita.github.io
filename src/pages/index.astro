---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';

const TITLE = 'Nikita Mikaev';
const SUBTITLE = 'Photography';

// Все фото из src/photos (JPG/PNG/WebP). Порядок — по имени файла (01-…, 02-… и т.д.).
// Конвертация в WebP и ресайз происходят при сборке, исходники в браузер не попадают.
const modules = import.meta.glob<{ default: ImageMetadata }>(
  '../photos/*.{jpg,jpeg,JPG,JPEG,png,PNG,webp,WEBP}',
  { eager: true },
);

// Превью в сетке: ширины под 1–3 колонки на обычных и retina-экранах.
const THUMB_WIDTHS = [480, 800, 1200, 1600];
const THUMB_QUALITY = 80;
// Полноэкранный просмотр: браузер сам выберет размер по экрану и DPR.
const FULL_WIDTHS = [1280, 1920, 2560];
const FULL_QUALITY = 85;

const photos = await Promise.all(
  Object.entries(modules)
    .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
    .map(async ([path, mod]) => {
      const name = path.split('/').pop()!.replace(/\.[^.]+$/, '');
      const alt = name.replace(/^\d+[-_ ]*/, '').replace(/[-_]+/g, ' ').trim() || 'Фото';
      const widths = FULL_WIDTHS.filter((w) => w < mod.default.width);
      if (widths.length === 0 || mod.default.width <= 2560) widths.push(Math.min(mod.default.width, 2560));
      const full = await getImage({
        src: mod.default,
        width: Math.min(mod.default.width, 1920), // fallback src для старых браузеров
        widths: [...new Set(widths)],
        sizes: '100vw',
        format: 'webp',
        quality: FULL_QUALITY,
      });
      return { src: mod.default, alt, href: full.src, srcset: full.srcSet.attribute };
    }),
);
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{TITLE} — {SUBTITLE}</title>
    <meta name="description" content={`${SUBTITLE} by ${TITLE}`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;1,400&family=Inter:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header>
      <h1>{TITLE}</h1>
      <p>{SUBTITLE}</p>
    </header>

    <main>
      {
        photos.length === 0 ? (
          <p class="empty">Положите фото (JPG, PNG или WebP) в <code>src/photos</code> — и они появятся здесь.</p>
        ) : (
          <div class="grid">
            {photos.map((p, i) => (
              <a class="item" href={p.href} data-srcset={p.srcset} style={`--d:${Math.min(i, 12) * 60}ms`}>
                <Image
                  src={p.src}
                  alt={p.alt}
                  width={Math.min(p.src.width, 1200)}
                  widths={THUMB_WIDTHS}
                  sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 33vw"
                  format="webp"
                  quality={THUMB_QUALITY}
                  loading={i < 3 ? 'eager' : 'lazy'}
                />
              </a>
            ))}
          </div>
        )
      }
    </main>

    <footer>© {new Date().getFullYear()} {TITLE}</footer>

    <div class="lightbox" hidden aria-modal="true" role="dialog">
      <button class="lb-close" aria-label="Закрыть">×</button>
      <button class="lb-prev" aria-label="Предыдущее">‹</button>
      <img class="lb-img" alt="" sizes="100vw" />
      <button class="lb-next" aria-label="Следующее">›</button>
      <span class="lb-count"></span>
    </div>

    <script>
      const items = [...document.querySelectorAll<HTMLAnchorElement>('.item')];
      const box = document.querySelector<HTMLElement>('.lightbox')!;
      const img = box.querySelector<HTMLImageElement>('.lb-img')!;
      const count = box.querySelector<HTMLElement>('.lb-count')!;
      let current = 0;

      function show(i: number) {
        current = (i + items.length) % items.length;
        const a = items[current];
        img.classList.remove('loaded');
        img.onload = () => img.classList.add('loaded');
        img.srcset = a.dataset.srcset ?? '';
        img.src = a.href;
        img.alt = a.querySelector('img')?.alt ?? '';
        count.textContent = `${current + 1} / ${items.length}`;
        // Подгружаем соседей заранее
        [current - 1, current + 1].forEach((j) => {
          const n = items[(j + items.length) % items.length];
          if (!n) return;
          const pre = new Image();
          pre.sizes = '100vw';
          pre.srcset = n.dataset.srcset ?? '';
          pre.src = n.href;
        });
      }

      function open(i: number) {
        show(i);
        box.hidden = false;
        document.body.style.overflow = 'hidden';
      }

      function close() {
        box.hidden = true;
        document.body.style.overflow = '';
      }

      items.forEach((a, i) =>
        a.addEventListener('click', (e) => {
          e.preventDefault();
          open(i);
        }),
      );

      box.querySelector('.lb-close')!.addEventListener('click', close);
      box.querySelector('.lb-prev')!.addEventListener('click', () => show(current - 1));
      box.querySelector('.lb-next')!.addEventListener('click', () => show(current + 1));
      box.addEventListener('click', (e) => {
        if (e.target === box) close();
      });

      document.addEventListener('keydown', (e) => {
        if (box.hidden) return;
        if (e.key === 'Escape') close();
        if (e.key === 'ArrowLeft') show(current - 1);
        if (e.key === 'ArrowRight') show(current + 1);
      });

      let startX = 0;
      box.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
      box.addEventListener('touchend', (e) => {
        const dx = e.changedTouches[0].clientX - startX;
        if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
      });
    </script>

    <style is:global>
      :root {
        --bg: #0e0e0e;
        --fg: #ededed;
        --muted: #8a8a8a;
        --gap: 14px;
        color-scheme: dark;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; }
      body {
        background: var(--bg);
        color: var(--fg);
        font-family: 'Inter', system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
    </style>

    <style>
      header {
        text-align: center;
        padding: clamp(48px, 10vw, 110px) 16px clamp(32px, 6vw, 64px);
      }
      h1 {
        font-family: 'Cormorant Garamond', Georgia, serif;
        font-weight: 400;
        font-size: clamp(2.4rem, 6vw, 4.2rem);
        letter-spacing: 0.02em;
        margin: 0;
      }
      header p {
        margin: 10px 0 0;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.35em;
        font-size: 0.75rem;
      }

      main {
        max-width: 1600px;
        margin: 0 auto;
        padding: 0 var(--gap);
      }
      .grid {
        columns: 3 320px;
        column-gap: var(--gap);
      }
      .item {
        display: block;
        margin-bottom: var(--gap);
        break-inside: avoid;
        overflow: hidden;
        border-radius: 3px;
        background: #1a1a1a;
        cursor: zoom-in;
        opacity: 0;
        animation: fade-in 0.8s ease forwards;
        animation-delay: var(--d);
      }
      .item :global(img) {
        display: block;
        width: 100%;
        height: auto;
        transition: transform 0.6s ease, filter 0.6s ease;
      }
      .item:hover :global(img) {
        transform: scale(1.03);
        filter: brightness(1.08);
      }
      @keyframes fade-in {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: none; }
      }

      .empty {
        text-align: center;
        color: var(--muted);
        padding: 80px 0;
      }
      code {
        background: #1d1d1d;
        padding: 2px 6px;
        border-radius: 4px;
      }

      footer {
        text-align: center;
        color: var(--muted);
        font-size: 0.8rem;
        padding: 56px 16px 40px;
      }

      .lightbox {
        position: fixed;
        inset: 0;
        z-index: 10;
        background: rgba(5, 5, 5, 0.96);
        display: flex;
        align-items: center;
        justify-content: center;
        animation: lb-in 0.25s ease;
      }
      .lightbox[hidden] { display: none; }
      @keyframes lb-in { from { opacity: 0; } }
      .lb-img {
        max-width: 92vw;
        max-height: 88vh;
        object-fit: contain;
        opacity: 0;
        transition: opacity 0.3s ease;
        user-select: none;
      }
      .lb-img.loaded { opacity: 1; }
      .lightbox button {
        position: absolute;
        background: none;
        border: 0;
        color: var(--fg);
        font-size: 2.6rem;
        line-height: 1;
        padding: 16px;
        cursor: pointer;
        opacity: 0.6;
        transition: opacity 0.2s;
      }
      .lightbox button:hover { opacity: 1; }
      .lb-close { top: 8px; right: 12px; }
      .lb-prev { left: 8px; top: 50%; transform: translateY(-50%); }
      .lb-next { right: 8px; top: 50%; transform: translateY(-50%); }
      .lb-count {
        position: absolute;
        bottom: 18px;
        color: var(--muted);
        font-size: 0.8rem;
        letter-spacing: 0.1em;
      }
      @media (max-width: 640px) {
        .lb-prev, .lb-next { display: none; }
        .lb-img { max-width: 100vw; }
      }
      @media (prefers-reduced-motion: reduce) {
        .item { animation: none; opacity: 1; }
        .item :global(img) { transition: none; }
      }
    </style>
  </body>
</html>
